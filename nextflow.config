manifest {
    name            = 'ckangas2/mageckinator'
    author          = 'Chase Kangas'
    homePage        = 'https://github.com/ckangas2/mageckinator'
    description     = 'MAGeCK reanalysis of a pooled CRISPR screen, with checks for the failures that do not raise errors'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    // input
    input                   = null      // samplesheet CSV: sample,fastq_1,condition,replicate
    comparisons             = null      // comparisons CSV: id,control,treatment,selection
    library                 = null      // sgRNA library CSV: sgRNA,sequence,gene
    count_table             = null      // optional: deposited matrix sgRNA,gene,<samples>

    // design
    min_replicates          = 2
    min_control_replicates  = null      // defaults to min_replicates; plasmid baselines are often 1

    // library
    control_genes           = 'Control,NonTargeting,NTC'   // control gene-label prefixes
    min_guides              = 3

    // mageck count
    sgrna_len               = 20

    // count QC gate
    min_mapped_frac         = 0.6
    min_coverage            = 100       // mapped reads per sgRNA
    max_zero_frac           = 0.3
    max_gini                = 0.35
    min_replicate_rho       = 0.8
    qc_skew_arms            = 'control' // control | all  (Gini/zero-frac scope)

    // mageck test / control checks
    fdr                     = 0.05
    max_control_hit_frac    = 0.05
    min_control_median_p    = 0.3
    essential_genes         = null      // optional positive-control list
    min_essential_hit_frac  = 0.3

    // reconcile
    published_hits          = null      // optional gene[,rank] list
    reconcile_top_n         = 100
    reconcile_min_recall    = 0.5

    // summary
    summary_top             = 10

    // output
    outdir                  = 'results'
    publish_dir_mode        = 'copy'

    // resources: hard ceilings for any single task
    max_cpus                = 16
    max_memory              = 64.GB
    max_time                = 24.h

    help                    = false
}

process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]
    container = 'ghcr.io/ckangas2/mageckinator:0.1.0'

    withLabel: process_single { cpus = 1; memory = { 2.GB  * task.attempt }; time = 1.h }
    withLabel: process_low    { cpus = 2; memory = { 4.GB  * task.attempt }; time = 2.h }
    // mageck count on a genome-scale library is the memory step.
    withLabel: process_medium { cpus = 4; memory = { 16.GB * task.attempt }; time = 6.h }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled   = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    test      { includeConfig 'conf/test.config' }
    gse158298 { includeConfig 'conf/gse158298.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
