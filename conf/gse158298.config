/*
 * Daniloski et al., Cell 2021 — genome-scale SARS-CoV-2 survival screen in
 * A549-ACE2, GeCKOv2 library, MAGeCK RRA. GEO: GSE158298.
 *
 *   bash scripts/fetch_library.sh          # GeCKOv2 human -> reference/GeCKOv2_library.csv
 *   bash scripts/fetch_counts.sh           # fast path: deposited sgRNA counts
 *   # or: bash scripts/fetch_runs.sh       # full path: FASTQ from SRA + samplesheet.csv
 *   nextflow run . -profile gse158298,docker
 *
 * Two comparisons, both positive selection: survivors (low and high MOI) vs
 * the plasmid library. Hits are genes whose knockout lets cells survive
 * infection. Compare against assets/daniloski_hits.tsv and RESULTS.md.
 *
 * Fast path vs full path:
 *   --count_table reference/GSE158298_counts.tsv   # skip mageck count
 * is set by fetch_counts.sh; comment it out to count FASTQ with fetch_runs.sh.
 */
params {
    library         = "reference/GeCKOv2_library.csv"
    input           = "samplesheet.csv"
    comparisons     = "${projectDir}/assets/gse158298_comparisons.csv"
    published_hits  = "${projectDir}/assets/daniloski_hits.tsv"
    essential_genes = "${projectDir}/assets/essential_genes_core.txt"

    // GeCKOv2 nontargeting controls are labelled "Non-Targeting Control".
    control_genes   = 'Non-Targeting,NonTargeting,NTC,Control'
    sgrna_len       = 20

    // genome-scale: ~1000x representation, so coverage is high and the
    // survivor arms skew hard — keep the Gini/zero gates on the baseline only.
    min_coverage        = 100
    min_mapped_frac     = 0.6
    qc_skew_arms        = 'control'
    reconcile_top_n     = 1000
    reconcile_min_recall = 0.5

    // Plasmid is often a single deep library.
    min_control_replicates = 1

    // set by fetch_counts.sh (fast path); remove to count FASTQ instead
    // count_table  = "reference/GSE158298_counts.tsv"
}
