/*
 * Minutes-scale end-to-end run on the synthetic screen in tests/data/.
 *
 *   nextflow run ckangas2/mageckinator -profile test,docker
 *
 * 50 targeted genes x 4 guides + 20 nontargeting control pseudo-genes.
 * Two Plasmid libraries, three HighMOI survivor libraries. 8 host-factor
 * genes are enriched ~5x in the survivors (positive selection), 8 essential
 * genes deplete ~8x (the assay's positive control), the rest are flat.
 * tests/check_test_results.py asserts each comes back as planted.
 */
params {
    input                  = "${projectDir}/tests/data/samplesheet.csv"
    comparisons            = "${projectDir}/tests/data/comparisons.csv"
    library                = "${projectDir}/tests/data/library.csv"
    published_hits         = "${projectDir}/tests/data/published_hits.tsv"
    essential_genes        = "${projectDir}/tests/data/essential_genes.txt"

    sgrna_len              = 20

    // the toy library is sequenced shallow by design: 280 guides at ~50x give
    // noisier replicate correlation than a real 1000x screen, so the rho floor
    // is relaxed here (the gse158298 profile keeps the default 0.8).
    min_coverage           = 40
    min_mapped_frac        = 0.8
    min_replicate_rho      = 0.7
    reconcile_top_n        = 20
    reconcile_min_recall   = 0.6

    max_cpus               = 2
    max_memory             = 6.GB
    max_time               = 1.h
}

process {
    withLabel: process_medium { cpus = 2; memory = 4.GB }
    withLabel: process_low    { cpus = 1; memory = 2.GB }
}
